<%- include('partials/header.ejs') %>

<body class="d-flex flex-column" style="min-height: 100vh;">


<div class="row featurette">
    <div class="col-xl-7 p-4">
      <h1 class="title d-flex flex-column text-center py-2">What is Friends of MSF&nbsp;?</h1>
      <p class="body-text text-center px-3 my-4 squish-text"> 
        The Friends of Médecins Sans Frontières (MSF) is a student-led organization dedicated to advocacy, education, and fundraising. Our chapter works to raise awareness over global medical and humanitarian efforts by engaging the UTD campus in meaningful discussion and initiative.
      </p>
     </div>

    <div class="col-xl-4 d-flex justify-content-center">
        <img class="imageSize img-fluid" src="assets/welcomeMSF.PNG" alt="Welcome to Friends of MSF @ UTD" />
    </div>
  </div>
    <hr>
<div class="container">
    <div class="row">
      <div class="col-12 col-md-6 d-flex flex-column align-items-center order-1 order-md-2">
        <h1 class="title text-center my-4">Meet Our Chapter !</h1>
        <p class="body-text text-center px-3 my-3">
            Our goal is not limited to supporting MSF in the present but to build a strong foundation that will allow this organization to thrive for years to come. The current officers are primarily students majoring in the medical field, but we welcome individuals from all disciplines who are passionate about global health and humanitarian work. We believe in fostering an open and welcoming environment, and are always ready to answer questions, offer support, or engage in meaningful discussions.
        </p>
      </div>
      <!-- Carousel Section (Left side) -->
        <div class="col-12 col-md-6 d-flex justify-content-center order-2 order-md-1">
          <div id="carouselExampleIndicators" class="carousel slide col-md-6 d-flex justify-content-center col-12 mx-5" data-bs-ride="carousel">
        <div class="carousel-inner p-5">
          <div class="carousel-item active overflow-hidden">
            <img src="assets/president.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="President of Friends of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/vicePresident.PNG" class="d-block w-100"  style="transform: scale(1.1);" alt="Vice President of Friends of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/digitalCoordinator.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Digital Coordinator of Friends of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/treasurer.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Treasurer of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/publicityChair1.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Publicity and Campaign Chair of Friends of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/publicityChair2.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Publicity and Campaign Chair of Friends of MSF">
          </div>
          <div class="carousel-item overflow-hidden">
            <img src="assets/eventsSecretary.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Events Secretary of Friends of MSF">
          </div>
            <div class="carousel-item overflow-hidden">
            <img src="assets/eventsSecretary2.PNG" class="d-block w-100" style="transform: scale(1.1);" alt="Second Events Secretary of Friends of MSF">
          </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </div>
<section class="container mt-0 mb-4 pb-4">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8 text-center">
        
        <!-- American Red Cross SVG & Headline -->
        <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
          <img src="assets/health_cross.svg" alt="American Red Cross Logo" width="36" height="36" class="flex-shrink-0">
          <h4 class="mb-0 fw-bold text-dark">Blood Drive Milestone</h4>
        </div>

        <!-- Description -->
        <p class="text-muted mb-3 fs-5">
          MSF @ UTD has helped donate <strong class="text-danger">73 Units</strong> of blood with our goal being <strong>100</strong> by the end of 2026!
        </p>

        <!-- Progress Bar -->
        <div class="progress" role="progressbar" aria-label="Blood drive goal progress" aria-valuenow="73" aria-valuemin="0" aria-valuemax="100" style="height: 26px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger fw-semibold" style="width: 73%;">
            73%
          </div>
        </div>

        <!-- Label Benchmarks -->
        <div class="d-flex justify-content-between mt-2 text-secondary small fw-medium">
          <span>0 Units</span>
          <span>Goal: 100 Units</span>
        </div>

      </div>
    </div>
  </section>

  <%- include('partials/footer.ejs') %>
</body>

<script>

const homeButton = document.querySelector('.home');
const contactButton = document.querySelector('.contact');
const photosButton = document.querySelector('.photos');
const joinButton = document.querySelector('.join');

contactButton.classList.remove('active');
photosButton.classList.remove('active');
joinButton.classList.remove('active');
homeButton.classList.add('active');

</script>